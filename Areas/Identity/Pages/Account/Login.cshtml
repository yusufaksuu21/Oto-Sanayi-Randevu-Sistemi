@page
@model SanayiRandevu.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="auth-card animate-in">
    <div class="card form-card">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <h2>Giriş Yap</h2>
                <p class="text-muted">Hesabınıza giriş yapın</p>
            </div>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">E-posta</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="ornek@email.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Şifre</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-check mb-4">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">Beni Hatırla</label>
                </div>

                <button id="login-submit" type="submit" class="btn btn-primary w-100 btn-glow mb-3">Giriş Yap</button>
                <p class="text-center mb-0">
                    Hesabınız yok mu?
                    <a asp-page="./Register">Kayıt olun</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
