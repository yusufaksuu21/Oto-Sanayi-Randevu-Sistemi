@page
@model SanayiRandevu.Pages.Vehicles.IndexModel
@{
    ViewData["Title"] = "Araçlarım";
}

<div class="page-header animate-in">
    <div>
        <h1 class="page-title">Araçlarım</h1>
        <p class="page-subtitle">Randevu almak için kayıtlı araçlarınızı yönetin.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary btn-glow">
        <i class="bi bi-plus-lg me-1"></i> Yeni Araç
    </a>
</div>

<partial name="_Alerts" />

@if (!Model.Vehicles.Any())
{
    <div class="empty-state animate-in">
        <div class="empty-icon"><i class="bi bi-car-front"></i></div>
        <h3>Henüz araç eklenmemiş</h3>
        <p>Randevu alabilmek için önce aracınızı ekleyin.</p>
        <a asp-page="Create" class="btn btn-primary">İlk Aracımı Ekle</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var v in Model.Vehicles)
        {
            <div class="col-md-6 col-lg-4 animate-in">
                <div class="card vehicle-card h-100">
                    <div class="card-body">
                        <div class="vehicle-plate">@v.Plate</div>
                        <h5 class="card-title mt-3">@v.Brand @v.Model</h5>
                        <p class="text-muted mb-0"><i class="bi bi-calendar3 me-1"></i>@v.Year</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3 px-3">
                        <a asp-page="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary me-1">Düzenle</a>
                        <a asp-page="Delete" asp-route-id="@v.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
