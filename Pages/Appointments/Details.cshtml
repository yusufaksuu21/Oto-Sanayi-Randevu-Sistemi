@page "{id:int}"
@model SanayiRandevu.Pages.Appointments.DetailsModel
@{
    ViewData["Title"] = "Randevu Detayı";
    var a = Model.Appointment;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <partial name="_Alerts" />

        <div class="card form-card animate-in">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h2 class="mb-1">@a.Service?.Name</h2>
                        <span class="text-muted">Randevu #@a.Id</span>
                    </div>
                    <span class="status-badge @AppointmentDisplayHelper.GetStatusBadgeClass(a.Status)">
                        @AppointmentDisplayHelper.GetStatusText(a.Status)
                    </span>
                </div>

                <div class="detail-grid mb-4">
                    <div class="detail-item">
                        <small>Tarih</small>
                        <strong>@a.AppointmentDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</strong>
                    </div>
                    <div class="detail-item">
                        <small>Saat</small>
                        <strong>@a.TimeSlot</strong>
                    </div>
                    <div class="detail-item">
                        <small>Araç</small>
                        <strong>@a.Vehicle?.Plate</strong>
                        <span class="d-block text-muted">@a.Vehicle?.Brand @a.Vehicle?.Model (@a.Vehicle?.Year)</span>
                    </div>
                    <div class="detail-item">
                        <small>Ücret</small>
                        <strong>@a.Service?.Price.ToString("N0") ₺</strong>
                        <span class="d-block text-muted">~@a.Service?.DurationMinutes dk</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(a.Notes))
                {
                    <div class="customer-note mb-3">
                        <small class="text-muted d-block mb-1">Mesajınız</small>
                        @a.Notes
                    </div>
                }

                @if (!string.IsNullOrEmpty(a.AdminReply))
                {
                    <div class="admin-reply mb-4">
                        <small class="d-block mb-1"><i class="bi bi-chat-dots me-1"></i>Dükkan Geri Bildirimi</small>
                        @a.AdminReply
                        @if (a.AdminReplyAt.HasValue)
                        {
                            <small class="d-block mt-2 opacity-75">
                                @a.AdminReplyAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </small>
                        }
                    </div>
                }

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-page="Index" class="btn btn-outline-secondary">Geri</a>
                    @if (a.Status is AppointmentStatus.Pending or AppointmentStatus.Confirmed)
                    {
                        <form method="post" asp-page-handler="Cancel" asp-route-id="@a.Id"
                              onsubmit="return confirm('Randevuyu iptal etmek istediğinize emin misiniz?');">
                            <button type="submit" class="btn btn-outline-danger">Randevuyu İptal Et</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
