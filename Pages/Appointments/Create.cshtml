@page
@model SanayiRandevu.Pages.Appointments.CreateModel
@{
    ViewData["Title"] = "Randevu Al";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card form-card animate-in">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h2 class="mb-2">Randevu Oluştur</h2>
                    <p class="text-muted">Adımları takip ederek kolayca randevu alın.</p>
                </div>

                <partial name="_Alerts" />

                @if (!Model.HasVehicles)
                {
                    <div class="alert alert-warning">
                        Randevu alabilmek için önce <a asp-page="/Vehicles/Create">araç eklemeniz</a> gerekiyor.
                    </div>
                }
                else
                {
                    <form method="post" id="appointmentForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="booking-step animate-in">
                            <span class="step-number">1</span>
                            <div class="flex-grow-1">
                                <label asp-for="Input.ServiceId" class="form-label fw-semibold"></label>
                                <select asp-for="Input.ServiceId" asp-items="Model.ServiceOptions" class="form-select">
                                    <option value="">Hizmet seçin...</option>
                                </select>
                                <span asp-validation-for="Input.ServiceId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="booking-step animate-in">
                            <span class="step-number">2</span>
                            <div class="flex-grow-1">
                                <label asp-for="Input.VehicleId" class="form-label fw-semibold"></label>
                                <select asp-for="Input.VehicleId" asp-items="Model.VehicleOptions" class="form-select">
                                    <option value="">Araç seçin...</option>
                                </select>
                                <span asp-validation-for="Input.VehicleId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="booking-step animate-in">
                            <span class="step-number">3</span>
                            <div class="flex-grow-1">
                                <label asp-for="Input.AppointmentDate" class="form-label fw-semibold"></label>
                                <input asp-for="Input.AppointmentDate" class="form-control" type="date"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")" id="appointmentDate" />
                                <span asp-validation-for="Input.AppointmentDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="booking-step animate-in">
                            <span class="step-number">4</span>
                            <div class="flex-grow-1">
                                <label class="form-label fw-semibold">Saat Seçin</label>
                                <input type="hidden" asp-for="Input.TimeSlot" id="selectedTimeSlot" />
                                <div id="timeSlots" class="time-slots-grid">
                                    <p class="text-muted mb-0">Önce tarih seçin...</p>
                                </div>
                                <span asp-validation-for="Input.TimeSlot" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="booking-step animate-in">
                            <span class="step-number">5</span>
                            <div class="flex-grow-1">
                                <label asp-for="Input.Notes" class="form-label fw-semibold"></label>
                                <textarea asp-for="Input.Notes" class="form-control" rows="3"
                                          placeholder="Aracınızdaki sorun veya özel isteklerinizi yazabilirsiniz..."></textarea>
                                <span asp-validation-for="Input.Notes" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary btn-lg btn-glow px-5">
                                <i class="bi bi-check2-circle me-2"></i>Randevuyu Onayla
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const dateInput = document.getElementById('appointmentDate');
            const slotsContainer = document.getElementById('timeSlots');
            const hiddenSlot = document.getElementById('selectedTimeSlot');

            async function loadSlots() {
                const date = dateInput.value;
                hiddenSlot.value = '';
                if (!date) {
                    slotsContainer.innerHTML = '<p class="text-muted mb-0">Önce tarih seçin...</p>';
                    return;
                }

                slotsContainer.innerHTML = '<div class="slot-loading"><span class="spinner-border spinner-border-sm"></span> Müsait saatler yükleniyor...</div>';

                try {
                    const res = await fetch(`?handler=AvailableSlots&date=${date}`);
                    const slots = await res.json();

                    if (!slots.length) {
                        slotsContainer.innerHTML = '<p class="text-warning mb-0"><i class="bi bi-exclamation-circle me-1"></i>Bu tarihte müsait saat yok.</p>';
                        return;
                    }

                    slotsContainer.innerHTML = slots.map(s =>
                        `<button type="button" class="time-slot-btn" data-slot="${s}">${s}</button>`
                    ).join('');

                    slotsContainer.querySelectorAll('.time-slot-btn').forEach(btn => {
                        btn.addEventListener('click', function () {
                            slotsContainer.querySelectorAll('.time-slot-btn').forEach(b => b.classList.remove('selected'));
                            this.classList.add('selected');
                            hiddenSlot.value = this.dataset.slot;
                        });
                    });

                    if (hiddenSlot.value) {
                        const selected = slotsContainer.querySelector(`[data-slot="${hiddenSlot.value}"]`);
                        if (selected) selected.classList.add('selected');
                    }
                } catch {
                    slotsContainer.innerHTML = '<p class="text-danger mb-0">Saatler yüklenemedi.</p>';
                }
            }

            dateInput.addEventListener('change', loadSlots);
            if (dateInput.value) loadSlots();
        });
    </script>
}
