<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OtoSanayi Randevu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark site-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                    <i class="bi bi-wrench-adjustable-circle me-2 brand-icon"></i>
                    <span>OtoSanayi<span class="brand-accent">Randevu</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Anasayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Services">Hizmetler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Contact">İletişim</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Appointments/Create">Randevu Al</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Appointments/Index">Randevularım</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Vehicles/Index">Araçlarım</a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-admin" asp-area="Admin" asp-page="/Appointments/Index">
                                        <i class="bi bi-shield-check me-1"></i>Admin
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-admin" asp-area="Admin" asp-page="/Customers/Index">Musteriler</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (!User.Identity?.IsAuthenticated ?? true)
                        {
                            <li class="nav-item">
                            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Giriş</a>
                            </li>
                            <li class="nav-item">
                            <a class="btn btn-primary btn-sm btn-glow ms-lg-2" asp-area="Identity" asp-page="/Account/Register">Kayıt Ol</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <span class="nav-user-badge">
                                    <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index")">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Çıkış</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (ViewData["FullWidth"] as bool? == true)
    {
        <main role="main">@RenderBody()</main>
    }
    else
    {
        <div class="container page-container">
            <main role="main" class="pb-4">@RenderBody()</main>
        </div>
    }

    <footer class="site-footer">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <span class="footer-brand"><i class="bi bi-wrench-adjustable-circle me-1"></i>OtoSanayi Randevu</span>
                    <p class="footer-text mb-0">Profesyonel oto servis randevu sistemi</p>
                </div>
                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <span>&copy; 2026 Yusuf Aksu</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
